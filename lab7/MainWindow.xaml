<Window x:Class="lab7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab7"
        mc:Ignorable="d"
        Title="Лабораторна робота 7" Height="450" Width="800">
    <Grid Margin="15" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Панель керування" Grid.Row="0" Margin="0, 0, 0, 15" Padding="10" BorderBrush="#DDDDDD">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Залишок маршруту (км):" VerticalAlignment="Center" Margin="0, 0, 10, 0"/>
                <TextBox x:Name="txtDistance" Width="100" Padding="5" Margin="0, 0, 15, 0" BorderBrush="#CCCCCC"/>
                <Button x:Name="btnCheck" Content="Оновити координати" Width="140" Padding="5" Background="#F0F0F0" BorderBrush="#CCCCCC" Click="btnUpdate_Click"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Журнал подій" Grid.Row="1" Padding="5" BorderBrush="#DDDDDD">
            <ListBox x:Name="lbLog" BorderThickness="0" Background="#FAFAFA" FontFamily="Consolas"/>
        </GroupBox>
    </Grid>
</Window>
